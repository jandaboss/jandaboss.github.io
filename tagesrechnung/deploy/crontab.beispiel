# Eintragen mit:  crontab -e
# Jeden Abend um 23:55 Uhr. Die Uhrzeit gilt in der Zeitzone des Rechners
# (prüfen mit "date"; auf UTC-Servern CRON_TZ=Europe/Berlin voranstellen, falls Ihr Cron das kann).
#
# ~/.tagesrechnung.env enthält (chmod 600 ~/.tagesrechnung.env):
#   TAGESRECHNUNG_SMTP_PASSWORT=geheim
#   TAGESRECHNUNG_EBAY_SECRET=PRD-…
55 23 * * *  set -a; . "$HOME/.tagesrechnung.env"; set +a; cd /opt/tagesrechnung && .venv/bin/tagesrechnung ausfuehren -c config.toml --nachholen 7 --logdatei tagesrechnung.log
