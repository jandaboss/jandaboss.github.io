# /etc/systemd/system/tagesrechnung.service
# Wird vom Timer (tagesrechnung.timer) jeden Abend gestartet.
[Unit]
Description=Tagesrechnung: Rechnungen zu den Bestellungen des Tages erstellen und versenden
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=tagesrechnung
WorkingDirectory=/opt/tagesrechnung
# Enthält z. B. (Rechte: chmod 600):
#   TAGESRECHNUNG_SMTP_PASSWORT=geheim
#   TAGESRECHNUNG_EBAY_SECRET=PRD-…
EnvironmentFile=/etc/tagesrechnung/geheim.env
# --nachholen 7: auch Bestellungen der Vortage, die erst später bezahlt wurden (z. B. Auktionen)
ExecStart=/opt/tagesrechnung/.venv/bin/tagesrechnung ausfuehren -c /etc/tagesrechnung/config.toml --nachholen 7
